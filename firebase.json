{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/tracking.html", "destination": "/tracking.html" },
      { "source": "/admin.html", "destination": "/admin.html" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
